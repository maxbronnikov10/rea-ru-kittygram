# Скопируйте в .env и задайте свои значения: cp .env.example .env

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Нужен, если сайт открывают по адресу, отличному от хоста запроса
CSRF_TRUSTED_ORIGINS=http://localhost:9000
# Только для запуска фронтенда отдельно через npm start
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL. Если POSTGRES_DB не задан, Django использует SQLite
POSTGRES_DB=kittygram
POSTGRES_USER=kittygram_user
POSTGRES_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Порт, на котором docker compose публикует сайт
GATEWAY_PORT=9000

# Лимиты запросов (DRF throttling)
THROTTLE_ANON=200/hour
THROTTLE_USER=5000/day
THROTTLE_DUEL_VOTES=60/hour

# Механика дуэлей
DUEL_ELO_K=32
DUEL_MAX_OPEN_PER_CAT=3
